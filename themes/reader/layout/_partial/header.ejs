<header class="site-header">
  <button class="icon-btn menu-btn" type="button" aria-label="開啟文章列表" aria-controls="sidebar" aria-expanded="false">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
  </button>
  <a class="brand" href="<%- url_for('/') %>">
    <span class="brand-mark" aria-hidden="true">A/</span>
    <span class="brand-name"><%= config.title %></span>
  </a>
  <div class="search" role="search">
    <label class="search-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input id="search" type="search" placeholder="搜尋文章、CVE、套件名稱" aria-label="搜尋文章" autocomplete="off" aria-controls="search-results" aria-expanded="false">
      <kbd>/</kbd>
    </label>
    <div class="search-results" id="search-results" hidden></div>
  </div>
  <nav class="site-nav" aria-label="主選單">
    <a href="<%- url_for('/archives/') %>">所有文章</a>
    <a href="<%- url_for('/about/') %>">關於</a>
    <a href="<%- url_for('/atom.xml') %>">RSS</a>
    <button class="icon-btn theme-btn" type="button" aria-label="切換深色模式">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </nav>
</header>
